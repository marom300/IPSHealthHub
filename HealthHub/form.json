{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "General",
            "expanded": true,
            "items": [
                {
                    "type": "SelectInstance",
                    "name": "ArchiveID",
                    "caption": "Archive instance (none = first Archive Control)",
                    "validModules": [
                        "{43192F0B-135B-4CE7-A0A7-1475603F3060}"
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "TimeZone",
                    "caption": "Time zone (day boundaries)",
                    "validate": "^[A-Za-z_]+(/[A-Za-z_+\\-0-9]+)*$"
                },
                {
                    "type": "CheckBox",
                    "name": "DebugMode",
                    "caption": "Debug mode (raw payloads into debug window and HealthHub/raw files)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Dashboard",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "DashboardEnabled",
                    "caption": "Dashboard active"
                },
                {
                    "type": "Label",
                    "name": "DashboardUrl",
                    "caption": "Dashboard URL"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "DashboardPin",
                    "caption": "PIN for waist entry (digits, empty = no PIN)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Health Connect ingest",
            "items": [
                {
                    "type": "Label",
                    "name": "IngestUrl",
                    "caption": "Webhook URL"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "IngestToken",
                            "caption": "Token",
                            "width": "350px"
                        },
                        {
                            "type": "Button",
                            "caption": "Regenerate token",
                            "onClick": "HH_RegenerateIngestToken($id);",
                            "confirm": "The phone app stops working until the new token is entered there. Continue?"
                        }
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "BodySources",
                    "caption": "Preferred sources body values (app package names, comma separated, empty = automatic)",
                    "width": "700px"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "ActivitySources",
                    "caption": "Preferred sources activity/sleep (app package names, comma separated, empty = automatic)",
                    "width": "700px"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "MeasureRule",
                            "caption": "Several body measurements per day",
                            "options": [
                                {
                                    "caption": "First session of the day, median (robust)",
                                    "value": "session"
                                },
                                {
                                    "caption": "First of the day (morning, fasting)",
                                    "value": "first"
                                },
                                {
                                    "caption": "Last of the day",
                                    "value": "last"
                                },
                                {
                                    "caption": "Average",
                                    "value": "avg"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "IngestKeepDays",
                            "caption": "Keep records for",
                            "suffix": " Tage",
                            "minimum": 3,
                            "maximum": 120
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "FDDB import",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "FddbEnabled",
                    "caption": "Nightly import active"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "FddbUser",
                            "caption": "FDDB user name or e-mail",
                            "width": "300px"
                        },
                        {
                            "type": "PasswordTextBox",
                            "name": "FddbPassword",
                            "caption": "FDDB password",
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "FddbHour",
                            "caption": "Import time hour",
                            "minimum": 0,
                            "maximum": 23
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "FddbMinute",
                            "caption": "minute",
                            "minimum": 0,
                            "maximum": 59
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "FddbDaysBack",
                            "caption": "Re-import days back",
                            "minimum": 1,
                            "maximum": 14,
                            "suffix": " Tage"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "MCP server (Claude)",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "McpEnabled",
                    "caption": "MCP server active"
                },
                {
                    "type": "Label",
                    "name": "McpUrl",
                    "caption": "MCP URL"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "McpToken",
                            "caption": "MCP token",
                            "width": "350px"
                        },
                        {
                            "type": "Button",
                            "caption": "Regenerate MCP token",
                            "onClick": "HH_RegenerateMcpToken($id);",
                            "confirm": "Claude Code / Claude Desktop must be reconfigured with the new token. Continue?"
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "McpMaxDays",
                    "caption": "Max. range per request",
                    "suffix": " Tage",
                    "minimum": 7,
                    "maximum": 366
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Goals",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "GoalText",
                    "caption": "Goal in your own words (for Claude and the dashboard)",
                    "width": "700px"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "KcalTarget",
                            "caption": "Calorie target",
                            "suffix": " kcal",
                            "minimum": 800,
                            "maximum": 5000
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ProteinTarget",
                            "caption": "Protein target",
                            "suffix": " g",
                            "minimum": 0,
                            "maximum": 400
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "FatTarget",
                            "caption": "Fat target",
                            "suffix": " g",
                            "minimum": 0,
                            "maximum": 300
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "PaceMin",
                            "caption": "Target pace from",
                            "suffix": " kg/week",
                            "digits": 2,
                            "minimum": -2,
                            "maximum": 2
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "PaceMax",
                            "caption": "to",
                            "suffix": " kg/week",
                            "digits": 2,
                            "minimum": -2,
                            "maximum": 2
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "StartDate",
                            "caption": "Start date (YYYY-MM-DD)",
                            "validate": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "StartWeight",
                            "caption": "Start weight",
                            "suffix": " kg",
                            "digits": 1,
                            "minimum": 0,
                            "maximum": 300
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "StartBodyFat",
                            "caption": "Start body fat",
                            "suffix": " %",
                            "digits": 1,
                            "minimum": 0,
                            "maximum": 70
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "StartLeanMass",
                            "caption": "Start lean mass",
                            "suffix": " kg",
                            "digits": 1,
                            "minimum": 0,
                            "maximum": 200
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "ExpansionPanel",
            "caption": "Health Connect sources seen",
            "items": [
                {
                    "type": "List",
                    "name": "SeenOrigins",
                    "rowCount": 8,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "Data type",
                            "name": "Type",
                            "width": "180px"
                        },
                        {
                            "caption": "Source (data_origin)",
                            "name": "Origin",
                            "width": "auto"
                        },
                        {
                            "caption": "Records",
                            "name": "Count",
                            "width": "90px"
                        },
                        {
                            "caption": "Last received",
                            "name": "Last",
                            "width": "150px"
                        }
                    ],
                    "values": []
                },
                {
                    "type": "Button",
                    "caption": "Forget buffered records",
                    "onClick": "HH_ResetIngestState($id); echo 'OK';",
                    "confirm": "Buffered Health Connect records are deleted (archive values stay). Continue?"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "DeleteFrom",
                            "caption": "Delete from (YYYY-MM-DD)",
                            "value": ""
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "DeleteTo",
                            "caption": "to (YYYY-MM-DD)",
                            "value": ""
                        },
                        {
                            "type": "Button",
                            "caption": "Delete Health Connect values",
                            "onClick": "echo HH_DeleteHealthConnectData($id, $DeleteFrom, $DeleteTo);",
                            "confirm": "Archived body, activity and sleep values of this range are deleted (FDDB and waist stay). Continue?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "FDDB import",
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Test login",
                            "onClick": "echo HH_FddbTestLogin($id);"
                        },
                        {
                            "type": "Button",
                            "caption": "Import now",
                            "onClick": "echo HH_FddbImportNow($id);"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "ImportFrom",
                            "caption": "Import from (YYYY-MM-DD)",
                            "value": ""
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "ImportTo",
                            "caption": "to (YYYY-MM-DD)",
                            "value": ""
                        },
                        {
                            "type": "Button",
                            "caption": "Import range",
                            "onClick": "echo HH_FddbImportRange($id, $ImportFrom, $ImportTo);"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Save the settings first. A range import runs in the background (about 1-2 s per day), progress is shown in the Status variable."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "MCP test",
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "McpTestTool",
                            "caption": "Tool",
                            "value": "get_weekly_summary",
                            "options": [
                                {
                                    "caption": "get_profile",
                                    "value": "get_profile"
                                },
                                {
                                    "caption": "get_daily_overview",
                                    "value": "get_daily_overview"
                                },
                                {
                                    "caption": "get_nutrition",
                                    "value": "get_nutrition"
                                },
                                {
                                    "caption": "get_food_entries",
                                    "value": "get_food_entries"
                                },
                                {
                                    "caption": "get_food_stats",
                                    "value": "get_food_stats"
                                },
                                {
                                    "caption": "get_meal_pattern",
                                    "value": "get_meal_pattern"
                                },
                                {
                                    "caption": "get_body",
                                    "value": "get_body"
                                },
                                {
                                    "caption": "get_activity",
                                    "value": "get_activity"
                                },
                                {
                                    "caption": "get_weekly_summary",
                                    "value": "get_weekly_summary"
                                }
                            ]
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "McpTestArgs",
                            "caption": "Arguments (JSON)",
                            "width": "450px",
                            "value": "{\"from\":\"2026-09-15\",\"to\":\"2026-10-19\"}"
                        },
                        {
                            "type": "Button",
                            "caption": "Run",
                            "onClick": "echo HH_McpTest($id, $McpTestTool, $McpTestArgs);"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Waist circumference",
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "WaistValue",
                            "caption": "Waist",
                            "suffix": " cm",
                            "digits": 1,
                            "minimum": 30,
                            "maximum": 250,
                            "value": 85
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "WaistDate",
                            "caption": "Date (empty = today)",
                            "value": ""
                        },
                        {
                            "type": "Button",
                            "caption": "Save",
                            "onClick": "if (HH_SetWaist($id, $WaistValue, $WaistDate)) { echo 'OK'; }"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Maintenance",
            "items": [
                {
                    "type": "Button",
                    "caption": "Archive self test",
                    "onClick": "echo HH_SelfTestArchive($id);"
                },
                {
                    "type": "Button",
                    "caption": "Consolidate last days now",
                    "onClick": "HH_Consolidate($id); echo 'OK';"
                },
                {
                    "type": "Button",
                    "caption": "System check",
                    "onClick": "echo HH_CheckSystem($id);"
                },
                {
                    "type": "Button",
                    "caption": "Remove invalid archive values",
                    "onClick": "echo HH_RemoveInvalidValues($id);",
                    "confirm": "Archived daily values outside the plausible range (e.g. 0 cm waist) are deleted. Continue?"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Active"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Invalid time zone"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "No archive instance found"
        }
    ]
}
